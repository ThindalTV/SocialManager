@using SocialManager.Modules.Social.Components.Events
@using Telerik.SvgIcons
@using SocialManager.Modules.Shared.Components
@inherits ComponentBase

<Card>
    <!-- Publish Date Picker -->
    <div class="publish-date-section">
        <label class="title-label">Publish Date (Optional)</label>
        <TelerikDateTimePicker @bind-Value="PublishDateLocal"
                               Placeholder="Publish immediately"
                               Format="yyyy-MM-dd HH:mm"
                               Width="300px" />
        @if (PublishDateLocal.HasValue)
        {
            <span class="date-helper">Scheduled for @PublishDateLocal.Value.ToString("f")</span>
        }
        else
        {
            <span class="date-helper">Will publish immediately when marked as published</span>
        }
    </div>

    <div class="publish-state">
        <TelerikSwitch @bind-Value="@PostState"
                       OnLabel="@(PostState ? "Published" : "Scheduled")"
                       OffLabel="Draft" OnChange="PublishedStateChanged" />
    </div>
</Card>

@code {
    [Parameter] public bool PostState { get; set; } // True if already posted
    [Parameter] public DateTimeOffset? PublishDate { get; set; }
    [Parameter] public EventCallback<DateTimeOffset?> PublishDateChanged { get; set; }
    [Parameter] public EventCallback<PublishedStateChangedEventArgs> PublishStateChanged { get; set; }

    private DateTime? PublishDateLocal
    {
        get => PublishDate?.LocalDateTime;
        set
        {
            var dto = value.HasValue ? new DateTimeOffset(value.Value) : (DateTimeOffset?)null;
            PublishDateChanged.InvokeAsync(dto);
        }
    }

    public async Task PublishedStateChanged()
    {
        await PublishStateChanged.InvokeAsync(new PublishedStateChangedEventArgs(PublishDateLocal, PostState));
    }


}