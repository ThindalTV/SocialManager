@using Telerik.Blazor.Components.Editor
@using Telerik.SvgIcons

<div class="editorContainer">
    <h2 class="editorHeader">
        <TelerikSvgIcon Icon="@SvgIcon.File" />
        Blog Post Content
    </h2>
    <div class="editorContent">
        <TelerikEditor Value="@Content"
                       ValueChanged="@OnContentChanged"
                       Tools="@EditorToolSets.All"
                       Height="100%"
                       Class="k-h-full" />
    </div>
</div>

@code {
    [Parameter]
    public string Content { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ContentChanged { get; set; }

    private async Task OnContentChanged(string value)
    {
        Content = value;
        await ContentChanged.InvokeAsync(value);
    }
}
