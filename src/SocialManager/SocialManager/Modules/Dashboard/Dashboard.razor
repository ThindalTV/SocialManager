@page "/"
@using SocialManager.Services
@using SocialManager.Shared.DTOs
@using SocialManager.Modules.Shared.Components
@inject IEntryService EntryService
@inject NavigationManager Navigation

<PageTitle>Dashboard - SocialManager</PageTitle>

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="dashboard-header">
        <div class="header-content">
            <h1 class="page-title">Dashboard</h1>
            <p class="page-description">Welcome back! Here's what's happening with your content.</p>
        </div>
        <TelerikButton Icon="@SvgIcon.Plus"
                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       Size="@ThemeConstants.Button.Size.Large"
                       OnClick="@(() => Navigation.NavigateTo("/blog/editor/new"))">
            New Post
        </TelerikButton>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <Card>
            <div class="stat-card-header">
                <div class="stat-content">
                    <p class="stat-label">Total Posts</p>
                    <h3 class="stat-value">@TotalPosts</h3>
                </div>
                <TelerikAvatar ThemeColor="@ThemeConstants.Avatar.ThemeColor.Primary"
                               Type="AvatarType.Icon"
                               Size="@ThemeConstants.Avatar.Size.Medium">
                    <TelerikSvgIcon Icon="@SvgIcon.File" />
                </TelerikAvatar>
            </div>
            <p class="stat-footer">
                <TelerikSvgIcon Icon="@SvgIcon.ArrowUp" Size="@ThemeConstants.SvgIcon.Size.Small" />
                @PublishedPosts published
            </p>
        </Card>

        <Card>
            <div class="stat-card-header">
                <div class="stat-content">
                    <p class="stat-label">Drafts</p>
                    <h3 class="stat-value">@DraftPosts</h3>
                </div>
                <TelerikAvatar ThemeColor="@ThemeConstants.Avatar.ThemeColor.Warning"
                               Type="AvatarType.Icon"
                               Size="@ThemeConstants.Avatar.Size.Medium">
                    <TelerikSvgIcon Icon="@SvgIcon.Pencil" />
                </TelerikAvatar>
            </div>
            <p class="stat-footer">Waiting to be published</p>
        </Card>

        <Card>
            <div class="stat-card-header">
                <div class="stat-content">
                    <p class="stat-label">Active Platforms</p>
                    <h3 class="stat-value">@ActivePlatforms</h3>
                </div>
                <TelerikAvatar ThemeColor="@ThemeConstants.Avatar.ThemeColor.Tertiary"
                               Type="AvatarType.Icon"
                               Size="@ThemeConstants.Avatar.Size.Medium">
                    <TelerikSvgIcon Icon="@SvgIcon.Share" />
                </TelerikAvatar>
            </div>
            <p class="stat-footer">Connected social accounts</p>
        </Card>

        <Card>
            <div class="stat-card-header">
                <div class="stat-content">
                    <p class="stat-label">Last Updated</p>
                    <h3 class="stat-value">@LastUpdated</h3>
                </div>
                <TelerikAvatar ThemeColor="@ThemeConstants.Avatar.ThemeColor.Info"
                               Type="AvatarType.Icon"
                               Size="@ThemeConstants.Avatar.Size.Medium">
                    <TelerikSvgIcon Icon="@SvgIcon.Clock" />
                </TelerikAvatar>
            </div>
            <p class="stat-footer">Most recent activity</p>
        </Card>
    </div>

    <!-- Quick Actions & Recent Activity -->
    <div class="content-grid">
        <!-- Left: Recent Posts -->
        <div class="recent-posts-section">
            <Card>
                <div class="section-header">
                    <h2 class="section-title">Recent Posts</h2>
                    <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                   OnClick="@(() => Navigation.NavigateTo("/blog/entries"))">
                        View All →
                    </TelerikButton>
                </div>

                @if (RecentPosts?.Any() == true)
                {
                    <div class="post-list">
                        @foreach (var post in RecentPosts)
                        {
                            <div class="post-list-item" @onclick="@(() => Navigation.NavigateTo($"/blog/editor/{post.Id}"))">
                                <div class="post-item-content">
                                    <div class="post-item-body">
                                        <div class="post-item-header">
                                            <h3 class="post-item-title">@post.Title</h3>
                                            @if (post.IsPublished)
                                            {
                                                <TelerikBadge ThemeColor="@ThemeConstants.Badge.ThemeColor.Success" Size="@ThemeConstants.Badge.Size.Small">Published</TelerikBadge>
                                            }
                                            else
                                            {
                                                <TelerikBadge ThemeColor="@ThemeConstants.Badge.ThemeColor.Warning" Size="@ThemeConstants.Badge.Size.Small">Draft</TelerikBadge>
                                            }
                                        </div>
                                        <div class="post-item-meta">
                                            <span class="meta-item">
                                                <TelerikSvgIcon Icon="@SvgIcon.Clock" Size="@ThemeConstants.SvgIcon.Size.Small" />
                                                @post.UpdatedDate?.ToString("MMM dd, yyyy")
                                            </span>
                                            @if (post.SocialPlatforms?.Any() == true)
                                            {
                                                <span class="meta-item">
                                                    <TelerikSvgIcon Icon="@SvgIcon.Share" Size="@ThemeConstants.SvgIcon.Size.Small" />
                                                    @post.SocialPlatforms.Count platforms
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <TelerikButton Icon="@SvgIcon.ChevronRight" FillMode="@ThemeConstants.Button.FillMode.Flat" Size="@ThemeConstants.Button.Size.Small" />
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <TelerikSvgIcon Icon="@SvgIcon.File" Size="@ThemeConstants.SvgIcon.Size.ExtraExtraLarge" />
                        <div class="empty-state-text">
                            <p class="empty-state-title">No posts yet</p>
                            <p class="empty-state-description">Create your first post to get started</p>
                        </div>
                        <TelerikButton Icon="@SvgIcon.Plus" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" OnClick="@(() => Navigation.NavigateTo("/blog/editor/new"))">Create Post</TelerikButton>
                    </div>
                }
            </Card>
        </div>

        <!-- Right: Quick Actions & Platform Status -->
        <div class="sidebar-column">
            <Card>
                <h2 class="k-h4 k-mb-lg">Quick Actions</h2>
                <div class="k-d-flex k-flex-col k-gap-md">
                    <TelerikButton Icon="@SvgIcon.File" FillMode="@ThemeConstants.Button.FillMode.Outline" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" Class="k-justify-content-start" OnClick="@(() => Navigation.NavigateTo("/blog/entries"))">Manage Blog Posts</TelerikButton>
                    <TelerikButton Icon="@SvgIcon.Image" FillMode="@ThemeConstants.Button.FillMode.Outline" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" Class="k-justify-content-start" OnClick="@(() => Navigation.NavigateTo("/posts"))">Social Media Posts</TelerikButton>
                    <TelerikButton Icon="@SvgIcon.Play" FillMode="@ThemeConstants.Button.FillMode.Outline" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" Class="k-justify-content-start" OnClick="@(() => Navigation.NavigateTo("/stream"))">Streaming Tools</TelerikButton>
                    <TelerikButton Icon="@SvgIcon.Gear" FillMode="@ThemeConstants.Button.FillMode.Outline" ThemeColor="@ThemeConstants.Button.ThemeColor.Base" Class="k-justify-content-start">Settings</TelerikButton>
                </div>
            </Card>

            <Card>
                <h2 class="k-h4 k-mb-lg">Platform Status</h2>
                <div class="k-d-flex k-flex-col k-gap-md">
                    <div class="k-d-flex k-justify-content-between k-align-items-center">
                        <div class="k-d-flex k-align-items-center k-gap-2">
                            <TelerikSvgIcon Icon="@SvgIcon.XLogo" Size="@ThemeConstants.SvgIcon.Size.Medium" />
                            <span>X (Twitter)</span>
                        </div>
                        <TelerikBadge ThemeColor="@ThemeConstants.Badge.ThemeColor.Success" Size="@ThemeConstants.Badge.Size.Small">Connected</TelerikBadge>
                    </div>
                    <div class="k-d-flex k-justify-content-between k-align-items-center">
                        <div class="k-d-flex k-align-items-center k-gap-2">
                            <TelerikSvgIcon Icon="@SvgIcon.Linkedin" Size="@ThemeConstants.SvgIcon.Size.Medium" />
                            <span>LinkedIn</span>
                        </div>
                        <TelerikBadge ThemeColor="@ThemeConstants.Badge.ThemeColor.Success" Size="@ThemeConstants.Badge.Size.Small">Connected</TelerikBadge>
                    </div>
                    <div class="k-d-flex k-justify-content-between k-align-items-center">
                        <div class="k-d-flex k-align-items-center k-gap-2">
                            <TelerikSvgIcon Icon="@SvgIcon.Facebook" Size="@ThemeConstants.SvgIcon.Size.Medium" />
                            <span>Facebook</span>
                        </div>
                        <TelerikBadge ThemeColor="@ThemeConstants.Badge.ThemeColor.Base" Size="@ThemeConstants.Badge.Size.Small">Not Connected</TelerikBadge>
                    </div>
                </div>
            </Card>
        </div>
    </div>
</div>

@code {
    private int TotalPosts { get; set; }
    private int PublishedPosts { get; set; }
    private int DraftPosts { get; set; }
    private int ActivePlatforms { get; set; } = 3;
    private string LastUpdated { get; set; } = "Today";
    private List<EntryListItemResponseDto>? RecentPosts { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Load recent posts (top 5)
        var result = await EntryService.GetEntriesAsync(1, 5, "UpdatedDate", "desc", null);
        RecentPosts = result.Items;
        TotalPosts = result.TotalCount;
        PublishedPosts = RecentPosts.Count(p => p.IsPublished);
        DraftPosts = RecentPosts.Count(p => !p.IsPublished);
        
        if (RecentPosts.Any())
        {
            var mostRecent = RecentPosts.First().UpdatedDate;
            if (mostRecent.HasValue)
            {
                var timeAgo = DateTimeOffset.UtcNow - mostRecent.Value;
                LastUpdated = timeAgo.TotalHours < 1 
                    ? "Just now" 
                    : timeAgo.TotalDays < 1 
                        ? "Today" 
                        : timeAgo.TotalDays < 7 
                            ? $"{(int)timeAgo.TotalDays}d ago"
                            : mostRecent.Value.ToString("MMM dd");
            }
        }
    }
}
