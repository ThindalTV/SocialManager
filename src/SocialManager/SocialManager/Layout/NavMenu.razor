<div class="top-row">
    <div class="nav-container">
        <a class="navbar-brand" href="">SocialManager</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav-menu">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon nav-icon-home" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="blog/entries">
                <span class="nav-icon nav-icon-list" aria-hidden="true"></span> Blog Entries
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="counter">
                <span class="nav-icon nav-icon-plus" aria-hidden="true"></span> Counter
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="weather">
                <span class="nav-icon nav-icon-list" aria-hidden="true"></span> Posts
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="weather">
                <span class="nav-icon nav-icon-list" aria-hidden="true"></span> Stream
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="weather">
                <span class="nav-icon nav-icon-list" aria-hidden="true"></span> Stream overlay
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="weather">
                <span class="nav-icon nav-icon-list" aria-hidden="true"></span> Stream prompter
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
